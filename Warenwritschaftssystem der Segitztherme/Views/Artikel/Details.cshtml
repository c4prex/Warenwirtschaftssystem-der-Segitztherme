@model Warenwritschaftssystem_der_Segitztherme.Models.Artikel

@{
    ViewData["Title"] = "Artikel Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h4 class="mb-0 fw-semibold">Artikel Details</h4>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.ArtikelName</dd>

                        <dt class="col-sm-4">Beschreibung</dt>
                        <dd class="col-sm-8">@Model.ArtikelBeschreibung</dd>

                        <dt class="col-sm-4">Gewicht</dt>
                        <dd class="col-sm-8">@Model.ArtikelGewicht</dd>

                        <dt class="col-sm-4">Maße</dt>
                        <dd class="col-sm-8">@Model.ArtikelMaße</dd>
                    </dl>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Zur Übersicht
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.ArtikelID"
                           class="btn btn-primary px-4">
                            Bearbeiten
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
