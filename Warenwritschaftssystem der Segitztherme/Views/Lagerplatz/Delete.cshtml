@model Warenwritschaftssystem_der_Segitztherme.Models.Lagerplatz

@{
    ViewData["Title"] = "Lagerplatz löschen";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger bg-opacity-10 border-bottom">
                    <h4 class="mb-0 text-danger fw-semibold">Lagerplatz löschen</h4>
                    <small class="text-muted">Dieser Vorgang kann nicht rückgängig gemacht werden</small>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">Lagerplatz</dt>
                        <dd class="col-7 fw-medium">@Model.LagerPlatzName</dd>

                        <dt class="col-5 text-muted">Lager ID</dt>
                        <dd class="col-7">@Model.LagerID</dd>

                        <dt class="col-5 text-muted">HU Anzahl</dt>
                        <dd class="col-7">@Model.HUAnzahl</dd>

                        <dt class="col-5 text-muted">Max. Gewicht</dt>
                        <dd class="col-7">@Model.MaxGewicht kg</dd>

                        <dt class="col-5 text-muted">Bereich</dt>
                        <dd class="col-7">@Model.LagerBereich</dd>

                        <dt class="col-5 text-muted">Typ</dt>
                        <dd class="col-7">@Model.LagerTyp</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" class="d-flex justify-content-between">
                        <input type="hidden" asp-for="LagerPlatzID" />

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Abbrechen
                        </a>

                        <button type="submit" class="btn btn-danger px-4">
                            Endgültig löschen
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
