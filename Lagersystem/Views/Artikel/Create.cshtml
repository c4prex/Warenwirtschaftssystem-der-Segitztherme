@model Lagersystem.Models.Artikel

@{
    ViewData["Title"] = "Artikel anlegen";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">Neuen Artikel anlegen</h5>
    </div>

    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ArtikelName" class="form-label"></label>
                <input asp-for="ArtikelName" class="form-control" />
                <span asp-validation-for="ArtikelName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ArtikelBeschreibung" class="form-label"></label>
                <input asp-for="ArtikelBeschreibung" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ArtikelGewicht" class="form-label"></label>
                <input asp-for="ArtikelGewicht" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ArtikelMaße" class="form-label"></label>
                <input asp-for="ArtikelMaße" class="form-control" />
            </div>
          

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
                <button type="submit" class="btn btn-success">Speichern</button>
            </div>
        </form>
    </div>
</div>

