@model Lagersystem.Models.Artikel

@{
    ViewData["Title"] = "Artikel bearbeiten";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom">
                    <h4 class="mb-0 fw-semibold">Lagerplatz bearbeiten</h4>
                </div>

                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="ArtikelID" />

                        <div class="mb-3">
                            <label asp-for="ArtikelName" class="form-label"></label>
                            <input asp-for="ArtikelName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ArtikelBeschreibung" class="form-label"></label>
                            <input asp-for="ArtikelBeschreibung" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ArtikelGewicht" class="form-label"></label>
                            <input asp-for="ArtikelGewicht" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ArtikelMaße" class="form-label"></label>
                            <input asp-for="ArtikelMaße" class="form-control" />
                        
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Abbrechen
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                Änderungen speichern
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
