@model Warenwritschaftssystem_der_Segitztherme.Models.HU

@{
    ViewData["Title"] = "Create";
}
<style>
    /* Chrome, Safari, Edge */
    .no-spin::-webkit-inner-spin-button,
    .no-spin::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    .no-spin {
        -moz-appearance: textfield;
    }
</style>


<h1 style="text-align:center;">Erstellung der Handling Unit</h1>
<br />
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="input-group mb-3">
                <label asp-for="HuId" class="input-group-text"></label>
                <input asp-for="HuId" class="form-control no-spin" type="number" placeholder="Geben Sie eine Zahl ein..." />
                <button type="submit" class="btn btn-primary">Erstellen</button>
            </div>

            <span asp-validation-for="HuId" class="text-danger"></span>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Zur Handling Übersicht</a>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
