

@model IEnumerable<Lagersystem.Models.Artikel>

@{
    ViewData["Title"] = "Artikel";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-semibold">Artikel</h4>
            <a asp-action="Create" class="btn btn-primary">
                Neuer Artikel
            </a>
        </div>

        <form class="d-flex" asp-action="Index" asp-controller="Artikel">
            <input name="suchstring" class="form-control me-1" type="search" placeholder="Suche" aria-label="Suche" value="@ViewData["CurrentFilter"]">
            <button class="btn btn-dark" type="submit">Suchen</button>
            @* <button class="btn btn-dark" asp-action="Index" class="text-dark">Zurücksetzen</button> *@
            <a asp-action="Index"
               asp-controller="Artikel"
               class="btn btn-link text-dark">
                Zurücksetzen
            </a>

        </form>


        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Beschreibung</th>
                        <th>Gewicht</th>
                        <th>Maße</th>
                        <th class="text-end">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ArtikelName</td>
                            <td>@item.ArtikelBeschreibung</td>
                            <td>@item.ArtikelGewicht</td>
                            <td>@item.ArtikelMaße</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.ArtikelID" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.ArtikelID" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                                <a asp-action="Delete" asp-route-id="@item.ArtikelID" class="btn btn-sm btn-outline-danger">Löschen</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
