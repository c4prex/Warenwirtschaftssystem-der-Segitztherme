@{
    ViewData["Title"] = "Home Page";
}
<div></div>
<html>
<head>
    <meta charset="UTF-8">
    <title>Kacheln im Div</title>
    <style>
        .container {
            display: flex; /* ordnet die Kacheln nebeneinander */
            gap: 40px; /* Abstand zwischen den Kacheln */
            flex-wrap: wrap; /* Zeilenumbruch bei vielen Kacheln */
            padding: 10px;
            background: white;
        }

        .tile {
            width: 200px;
            height: 75px;
            background-color: lightblue;
            color: black;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.3s;
        }

            .tile:hover {
                transform: scale(1.05);
                background-color: #45a049;
            }
    </style>
</head>
<body>
    <div class="tile" onclick="alert('In Bearbeitung!')">Personalverwaltung</div>
    <div class="tile" onclick="alert('In Bearbeitung!')">Finanzverwaltung</div>
</body>
</html>

