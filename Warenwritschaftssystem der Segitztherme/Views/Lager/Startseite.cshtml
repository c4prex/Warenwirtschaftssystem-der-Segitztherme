@{
    ViewData["Title"] = "Startseite";
}


<html>
<head>
    <style>
        h1 {
            text-align: center; /* Text wird horizontal zentriert */
        }
    </style>
</head>
<body>
    <h1>Lagerverwaltungssystem</h1>
</body>
</html>
<br />
<html>
<head>
    <style>
        .rahmen {
            border: 2px solid black;
            width: auto; /* feste Breite */
            height: 500px;
            margin-left: 0; /* Abstand links = 0 */
            margin-right: auto; /* schiebt den Rahmen nach links */
            text-align: left; /* Inhalt im Rahmen linksbündig */
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <div class="rahmen">
        Dies ist ein Text mit Rahmen.
    </div>
</body>
</html>

